# ===========================================================================
#  dmcheck 达梦连接诊断工具 · 配套配置文件
# ---------------------------------------------------------------------------
#  改完保存即可，不需要重启任何服务，重新执行 dmcheck 就会读到新值。
#
#  填写规则（写错了工具会连不上，请务必看一遍）：
#    · 一行一个配置，格式是   键=值
#    · 等号两边不要留空格
#    · 不要写 export
#    · 以 # 或 ; 开头的是注释行
#    · 值本身不需要加引号，加了也会被自动去掉
#    · 密码里如果含 #  号，前面千万不能有空格，否则 # 后面的内容会被当成注释丢掉
#    · 密码里含特殊字符（@ ? : # % 空格等）不用做任何转义，原样写就行
#
#  提示：如果你的迁移程序也在用 .env，可以把里面 DM_ 开头的几行直接复制过来
#       覆盖下面这一段——两个文件的字段名是完全一样的。
# ===========================================================================

# ------------------------------- 达梦数据库 -------------------------------

# 达梦服务器 IP 或主机名。填 IP 最稳妥；填主机名要求本机 DNS 能解析
DM_HOST=127.0.0.1

# 达梦监听端口。达梦默认是 5236，不要照抄旧环境用过的 5237
DM_PORT=5236

# 登录用户名。达梦默认区分大小写，SYSDBA 和 sysdba 是两个不同的账号
DM_USER=SYSDBA

# 登录密码。原样填写，含特殊字符也不要转义，不要加引号
DM_PASS=SYSDBA

# 登录后的默认模式。一般留空即可，留空表示使用登录用户自带的默认模式
# 只有当你要显式指定模式时才填，例如 DLPDATA
DM_SCHEMA=

# --------------------------- 以下本工具不使用 -----------------------------
# 本工具只诊断达梦，下面这些 MongoDB 配置不参与连接测试，留在这里是为了
# 方便你对比两个文件的字段名。需要的话也可以把迁移程序的 .env 整份复制
# 过来覆盖，多出来的字段会被自动忽略。

# MONGO_HOST=127.0.0.1
# MONGO_PORT=32017
# MONGO_DB=identity
# MONGO_USERNAME=root
# MONGO_PASSWORD=
